{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kamp Telsizi",
  "mainBinaryName": "KampTelsizi",
  "identifier": "io.github.memir2133.kamptelsizi",
  "build": {
    "frontendDist": "../ses"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kamp Telsizi",
        "width": 460,
        "height": 780,
        "minWidth": 360,
        "minHeight": 520,
        "useHttpsScheme": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Oyun için sesli sohbet",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Kamp Telsizi"
      }
    }
  }
}
